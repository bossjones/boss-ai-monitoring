# boss-ai-monitoring — environment variable reference.
# Copy to the real env file and fill in the blanks. Nothing here is required to run the app:
# every BAM_* var has a code default (see config.sample.yaml), and the LangSmith poller degrades
# gracefully when no API key is set.

# ── Claude Code → OTLP receiver (:4318) ───────────────────────────────────────
# Export these in the shell where you run Claude Code, so it ships telemetry to us.
CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/json      # http/json ONLY — no gRPC, no otel-collector
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Optional pacing: OTEL_METRIC_EXPORT_INTERVAL=60000, OTEL_LOGS_EXPORT_INTERVAL=5000
#
# PRIVACY: the content-capture flags below stay OFF by default — telemetry is metadata unless you
# deliberately opt in. Uncomment only if you accept prompt/response/tool text leaving the process.
# OTEL_LOG_USER_PROMPTS=1
# OTEL_LOG_ASSISTANT_RESPONSES=1
# OTEL_LOG_TOOL_DETAILS=1

# ── LangSmith (two keys, two jobs) ────────────────────────────────────────────
# CC_LANGSMITH_* feeds the Claude Code tracing plugin (traces going OUT to LangSmith).
# LANGSMITH_API_KEY feeds our poller and the `langsmith` CLI (runs coming BACK IN).
TRACE_TO_LANGSMITH=true
CC_LANGSMITH_API_KEY=
CC_LANGSMITH_PROJECT=boss-ai-monitoring
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"  # For self-hosted
LANGSMITH_WORKSPACE_ID=""                # Default workspace get from lansmith
LANGSMITH_PROJECT="boss-ai-monitoring"                 # Default project for queries
# CC_LANGSMITH_PROJECT and LANGSMITH_PROJECT must name the SAME project: the poller ingests the
# former, the read-back check (`langsmith run list --project "$LANGSMITH_PROJECT"`) reads the latter.

# ── boss-ai-monitoring itself (BAM_ prefix, __ for nesting) ───────────────────
# Env beats config.yaml beats code defaults. Print the resolved DB path with:
#   uv run bam config db-path
BAM_DB_PATH=                               # legacy alias, kept for reference; prefer the nested form
BAM_STORE__DB_PATH=~/.local/share/boss-ai-monitoring/bam.duckdb
BAM_CLAUDE_PROJECTS_DIR=                   # legacy alias; prefer the nested form
BAM_INGEST__CLAUDE_PROJECTS_DIR=~/.claude/projects   # mounted READ-ONLY wherever it is read
BAM_SERVER__DASHBOARD_PORT=8000
BAM_SERVER__OTLP_PORT=4318
# BAM_CONFIG=./config.yaml                 # point at an alternate YAML config file